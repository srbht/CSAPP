NODE_ENV=development
PORT=3000
DATABASE_URL=mysql://cps:cpspass@127.0.0.1:3306/cps_erp
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
SCHOOL_CODE=CPS
STORAGE_DIR=./storage
LOGIN_RATE_LIMIT_PER_MINUTE=5
CORS_ORIGIN=
# Used only by the seed script (first super admin)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# Requests per minute per client IP (the school's staff usually share one IP)
API_RATE_LIMIT_PER_MINUTE=1200
